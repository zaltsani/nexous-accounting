{
  "name": "nexous-accounting",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "packages/*/*",
    "libs/*/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "start": "nx run-many -t start",
    "dev": "nx run-many -t dev",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t test:e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "docker:build": "nx run-many -t docker:build",
    "docker:build:api-gateway": "docker build -f apps/api-gateway/Dockerfile -t api-gateway .",
    "docker:build:services-core": "docker build -f services/core/Dockerfile -t services-core ."
  },
  "dependencies": {
    "@nexous-accounting/common": "*",
    "@nexous-accounting/database-core": "*",
    "@nexous-accounting/types": "*",
    "@nexous/ui": "*",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "react-hook-form": "^7.72.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "nx": "23.1.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  }
}

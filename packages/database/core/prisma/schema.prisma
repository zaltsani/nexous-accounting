generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator clientCjs {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma-cjs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id            String        @id @default(uuid())
  parentId      String?       @map("parent_id")
  code          String        @unique
  name          String
  type          AccountType
  normalBalance NormalBalance @map("normal_balance")
  balance       Decimal       @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parent Account? @relation("AccountToParent", fields: [parentId], references: [id], onDelete: Restrict)

  // Inverse Relations
  children Account[] @relation("AccountToParent")
  entries  Entry[]
  mappings AccountMapping[]

  @@index([parentId])
  @@map("accounts")
}

model Journal {
  code String @id @unique
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Inverse Relations
  transactions Transaction[]

  @@map("journals")
}

model Transaction {
  id          String   @id @default(uuid())
  journalCode String   @map("journal_code")
  date        DateTime
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  journal Journal @relation(fields: [journalCode], references: [code])

  // Inverse Relations
  entries Entry[]

  @@index([journalCode, date])
  @@map("transactions")
}

model Entry {
  id String @id @default(uuid())
  transactionId String  @map("transaction_id")
  accountId String  @map("account_id")
  amount Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@map("entries")
}

model AccountMapping {
  id        String @id @default(uuid())
  operation String @unique
  accountId String @map("account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_mappings")
}

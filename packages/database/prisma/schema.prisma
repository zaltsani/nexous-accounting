generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator clientCjs {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma-cjs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "inventory"]
}

// =================
// Core Accounting =
// =================

enum NormalBalance {
  DEBIT
  CREDIT

  @@schema("core")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@schema("core")
}

model Account {
  id            String        @id @default(uuid())
  parentId      String?       @map("parent_id")
  code          String        @unique
  name          String
  type          AccountType
  normalBalance NormalBalance @map("normal_balance")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parent Account? @relation("AccountToParent", fields: [parentId], references: [id], onDelete: Restrict)

  // Inverse Relations
  children Account[] @relation("AccountToParent")
  entries  Entry[]

  productInventoryAccounts Product[] @relation("ProductInventoryAccount")
  productCogsAccounts      Product[] @relation("ProductCogsAccount")
  productSalesAccounts     Product[] @relation("ProductSalesAccount")

  @@index([parentId])
  @@map("accounts")
  @@schema("core")
}

model Journal {
  id   String @id @default(uuid())
  code String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Inverse Relations
  transactions Transaction[]

  @@map("journals")
  @@schema("core")
}

model Transaction {
  id          String   @id @default(uuid())
  journalId   String   @map("journal_id")
  date        DateTime
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  journal Journal @relation(fields: [journalId], references: [id])

  // Inverse Relations
  entries Entry[]
  stockMovements StockMovement[]

  @@index([journalId, date])
  @@map("transactions")
  @@schema("core")
}

model Entry {
  id String @id @default(uuid())
  transactionId String  @map("transaction_id")
  accountId String  @map("account_id")
  amount Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@map("entries")
  @@schema("core")
}


// ===========
// INVENTORY =
// ===========

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT

  @@schema("inventory")
}

model Product {
  id String @id @default(uuid())
  sku String @unique
  barcode String? @unique
  name String
  description String?
  unit String
  
  price       Decimal  @db.Decimal(18, 4)

  inventoryAccountId String @map("inventory_account_id")
  cogsAccountId String @map("cogs_account_id")
  salesAccountId String @map("sales_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  inventoryAccount Account @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id])
  cogsAccount Account @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])
  salesAccount Account @relation("ProductSalesAccount", fields: [salesAccountId], references: [id])

  // Inverse Relations
  batches InventoryBatch[]
  stockMovements StockMovement[]

  @@index([inventoryAccountId])
  @@index([cogsAccountId])
  @@index([salesAccountId])
  @@map("products")
  @@schema("inventory")
}

model InventoryBatch {
  id String @id @default(uuid())
  productId String @map("product_id")
  
  unitCost Decimal @map("unit_cost") @db.Decimal(18, 4)
  initialQty Decimal @map("initial_qty") @db.Decimal(18, 4)
  remainingQty Decimal @map("remaining_qty") @db.Decimal(18, 4)
  
  receivedAt DateTime @default(now()) @map("received_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id])

  // Inverse Relations
  stockMovements StockMovement[]

  @@index([productId, remainingQty])
  @@map("inventory_batches")
  @@schema("inventory")
}

model StockMovement {
  id String @id @default(uuid())
  productId String @map("product_id")
  batchId String? @map("batch_id")
  transactionId String? @map("transaction_id")

  type StockMovementType
  quantity Decimal @db.Decimal(18, 4)
  unitCost Decimal @map("unit_cost") @db.Decimal(18, 4)
  totalValue Decimal @map("total_value") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  product     Product         @relation(fields: [productId], references: [id])
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
  @@index([productId])
  @@index([batchId])
  @@index([transactionId])
  @@schema("inventory")
}
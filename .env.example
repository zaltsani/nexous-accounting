COMPOSE_PROJECT_NAME=nexous-accounting

WEB_IMAGE=ghcr.io/zaltsani/nexous-accounting/web:latest
API_GATEWAY_IMAGE=ghcr.io/zaltsani/nexous-accounting/api-gateway:latest
CORE_IMAGE=ghcr.io/zaltsani/nexous-accounting/core:latest

NATS_PORT=4222
NATS_URL=nats://localhost:4222
APP_PORT=5173
API_PORT=3000

NODE_ENV=development

VITE_PUBLIC_BACKEND_URL=http://localhost:3000
VITE_MAINTENANCE_MODE=development
VITE_SITE_DOMAIN=localhost

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=nexous_accounting
POSTGRES_PORT=5434

DATABASE_URL=postgresql://username:password@localhost:5434/nexous_accounting?schema=public

JWT_ACCESS_TOKEN_SECRET="jwt-secret-sing-panjang-lamun-bisa-mah"
JWT_REFRESH_TOKEN_SECRET="beda-jwt-secret-nu-ieu-mah"
JWT_ACCESS_TOKEN_EXPIRATION=86400000 # 24H
JWT_REFRESH_TOKEN_EXPIRATION=604800000 # 7D
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "paths": {
      "@nexous-accounting/types": ["./packages/types/dist/index.d.ts"],
      "@nexous-accounting/database": ["./packages/database/dist/index.d.ts"],
      "@nexous-accounting/common": ["./libs/nodejs/common/dist/index.d.ts"]
    }
  }
}
